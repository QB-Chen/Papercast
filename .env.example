# Local LLM gateway — must be OpenAI-compatible
# Replace with your own gateway URL
BIFROST_URL=http://localhost:8080

# Optional: override the default language (zh or en)
# VIDEO_LANG=zh

# Optional: override ASR model
# ASR_MODEL=siliconflow/XingChenAGI/XingChenASR-V3.2

# Optional: bypass paper source allowlist (use with caution)
# ALLOW_ANY_MODEL=1
