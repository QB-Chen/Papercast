{
  "name": "explainer-video",
  "version": "0.1.0",
  "private": true,
  "description": "类比驱动的扁平信息图讲解视频(Remotion)样片",
  "scripts": {
    "postinstall": "node scripts/patch-remotion-timeout.mjs",
    "dev": "remotion studio src/index.ts",
