    "still": "remotion still src/index.ts Sample out/still.png",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.542",
    "@remotion/lottie": "4.0.542",
    "cheerio": "^1.2.0",
    "gsap": "^3.15.1",
    "katex": "^0.19.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.542"
  },
  "devDependencies": {
    "@types/react": "19.1.0",
    "typescript": "5.8.3"
  }
}
